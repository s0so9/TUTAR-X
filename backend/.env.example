# Football Intelligence (TUTAR X) backend configuration
# Copy this file to backend/.env and adjust. Every key here maps to a field in
# app/config.py (Settings); unknown keys are rejected at startup.
# Real environment variables override values in .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development default: local SQLite file in backend/ (relative to the CWD).
DATABASE_URL=sqlite:///./football_intelligence.db
# Production / PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/football_intelligence

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8003
API_DEBUG=false

# CORS: must be a JSON list (pydantic-settings parses list fields as JSON).
# Comma-separated values (a,b) will NOT work.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# AI Analyst (local Ollama only)
# ---------------------------------------------------------------------------
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b

# ---------------------------------------------------------------------------
# Football data providers
# ---------------------------------------------------------------------------
# true  -> HybridProvider: local database first, external providers as fallback
#          (use this to see real imported matches)
# false -> DevelopmentProvider only: MOCK data, labeled as development data,
#          never real football data
USE_REAL_PROVIDERS=true

# Provider base URLs (used when USE_REAL_PROVIDERS=true)
# FotMob is an unofficial, undocumented source; endpoints are appended as /api/data/...
RYZELLX_BASE_URL=http://localhost:3001
FOTMOB_BASE_URL=https://www.fotmob.com
OPENLIGADB_BASE_URL=https://api.openligadb.de

PROVIDER_TIMEOUT_SECONDS=10.0
PROVIDER_RETRY_COUNT=2

# Prediction thresholds mode.
# false (production thresholds, recommended) | true (relaxed development thresholds)
FI_IS_DEVELOPMENT=false

# ---------------------------------------------------------------------------
# Feature engineering
# ---------------------------------------------------------------------------
TEAM_FORM_WINDOW=5
MIN_SAMPLE_SIZE=3

# ---------------------------------------------------------------------------
# The Odds API (bookmaker odds; PAID, quota-limited)
# ---------------------------------------------------------------------------
# Leave the key empty and keep it disabled unless you have a subscription.
# Never commit a real key.
THE_ODDS_API_KEY=
THE_ODDS_API_ENABLED=false
THE_ODDS_API_MIN_REMAINING_REQUESTS=50

# ---------------------------------------------------------------------------
# Admin security
# ---------------------------------------------------------------------------
# Required for POST /api/v1/odds/manual-update (triggers paid API calls).
# Empty = endpoint disabled (returns 503). Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Send it as:  Authorization: Bearer <token>
FI_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Headline pick tracking (Banko / Oranli result tracking)
# ---------------------------------------------------------------------------
# In-app background loop (every 60 s): freezes the Banko and Oranli of every featured-competition
# match about 20 minutes before kick-off and settles them after full time. On by default.
HEADLINE_TRACKING_ENABLED=true
HEADLINE_FREEZE_MINUTES_BEFORE=20
